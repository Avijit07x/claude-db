{
  "name": "claude-db",
  "version": "0.10.2",
  "description": "Persistent memory for Claude Code. Captures why decisions were made, not just which files changed. Bring your own database: SQLite, MongoDB or Postgres. No cloud, no subscription.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "claude-db": "./dist/cli/index.js",
    "cdb": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./store": "./dist/store/index.js"
  },
  "files": [
    "dist",
    "skills",
    "docs/how-it-works.md",
    "docs/with-and-without.md",
    "docs/setup-guide.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && node scripts/prune-dist.mjs",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/lint.mjs && eslint . && node scripts/check-fixtures.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "test": "node scripts/unit.mjs && node scripts/local.mjs && node scripts/filter.mjs && node scripts/transcript.mjs && node scripts/inject.mjs && node scripts/smoke.mjs",
    "coverage": "c8 npm test",
    "check:package": "npm run build && publint && attw --pack . --profile esm-only",
    "knip": "knip",
    "smoke": "node scripts/smoke.mjs",
    "unit": "node scripts/unit.mjs",
    "local": "node scripts/local.mjs",
    "try": "node scripts/try.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:tokens": "node scripts/bench-tokens.mjs",
    "bench:ab": "node scripts/bench-ab.mjs",
    "bench:inject": "node scripts/bench-inject.mjs",
    "postinstall": "node -e \"const v=process.versions.node.split('.').map(Number); if(v[0]<22||(v[0]===22&&v[1]<16)){console.error('\\n  claude-db needs Node >= 22.16 (its builtin SQLite has full-text search from there). You have '+process.versions.node+'.\\n');process.exit(1)}\"",
    "prepublishOnly": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-ruby": "^0.0.7",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/napi": "^0.45.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "prettier": "^3.8.0",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-plugin",
    "claude-code-hooks",
    "memory",
    "ai-memory",
    "agent-memory",
    "long-term-memory",
    "persistent-memory",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "rag",
    "embeddings",
    "vector-search",
    "semantic-search",
    "sqlite",
    "mongodb",
    "postgres",
    "pgvector"
  ],
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@xenova/transformers": "^2.17.2",
    "mongodb": "^7.5.0",
    "pg": "^8.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avijit07x/claude-db.git"
  },
  "bugs": {
    "url": "https://github.com/Avijit07x/claude-db/issues"
  },
  "homepage": "https://github.com/Avijit07x/claude-db#readme",
  "author": "Avijit Dey",
  "publishConfig": {
    "access": "public"
  }
}
